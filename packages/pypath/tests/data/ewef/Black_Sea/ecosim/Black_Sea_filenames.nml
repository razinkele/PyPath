&filenames

HDF5_fname            = "testcases/Black_Sea/Black_Sea.h5"
GroupInfo_fname       = "testcases/Black_Sea/Black_Sea_Scenario.csv"
Vulnerability_fname   = "testcases/Black_Sea/Black_Sea_vul.csv"
Forcing_fname         = "testcases/Black_Sea/Black_Sea_F.csv"
NutrientForcing_fname = "testcases/Black_Sea/Black_Sea_NutForce.csv"
SpatialGrid_fname     = "testcases/Black_Sea/Black_Sea_grid.csv"
SpatialDistribution_dirname = "testcases/Black_Sea/Black_Sea_SpatialDistribution/"
Advection_fname       = "testcases/Black_Sea/Black_Sea_Advection.csv"
SpatialResults_fname  = "testcases/Black_Sea/Black_Sea_spatial_results.h5"

! number of years to simulate
tf              = 2

! time steps per month
StepsPerMonth   = 1

! base proportion of free nutrients
NutBaseFreeProp = 0.9

! max P/B due to nutrient concentration
NutPBmax        = 1.5

! relaxation parameter
relax           = 0.5

/
